{
  "name": "tasteloom",
  "version": "0.1.0",
  "description": "Real gifts for what someone loves, with the reason. Taste links from Qloo, an agent on Cloudflare Workers AI, real product cards from Channel3, experience links from Tavily, PayPal sandbox guest checkout.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev-vars.mjs && wrangler dev --port 8791 --var DEV_CACHE:1",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir .build",
    "e2e": "node scripts/e2e.mjs",
    "contract:qloo": "node --experimental-strip-types scripts/contract-qloo.ts",
    "scan": "node scripts/scan.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
