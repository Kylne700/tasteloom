{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasteloom",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "KV" }],
  "durable_objects": { "bindings": [{ "name": "METER", "class_name": "MeterDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeterDO"] }],
  "vars": {}
}
