{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasteloom",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "KV" }],
  "durable_objects": { "bindings": [{ "name": "METER", "class_name": "MeterDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeterDO"] }],
  "vars": {
    "LIMIT_IP_IDEAS": "8",
    "LIMIT_IP_QLOO": "60",
    "LIMIT_IP_AI": "80",
    "LIMIT_IP_NEURONS": "1500",
    "LIMIT_IP_TAVILY": "20",
    "LIMIT_IP_CHANNEL3": "24",
    "LIMIT_IP_ORDERS": "8",
    "LIMIT_IP_RETURNS": "20",
    "LIMIT_GLOBAL_IDEAS": "100",
    "LIMIT_GLOBAL_QLOO": "600",
    "LIMIT_GLOBAL_AI": "600",
    "LIMIT_GLOBAL_NEURONS": "8000",
    "LIMIT_GLOBAL_TAVILY": "25",
    "LIMIT_GLOBAL_CHANNEL3": "25",
    "LIMIT_GLOBAL_ORDERS": "100",
    "LIMIT_GLOBAL_RETURNS": "150",
    "LIMIT_DAILY_CAP_USD": "2000",
    "LIMIT_MAX_ITEMS": "6",
    "LIMIT_MAX_BUDGET_USD": "500"
  }
}
